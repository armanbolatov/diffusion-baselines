# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# uv / venv
.venv/

# Results: exps*/ log.jsonl and figures ARE tracked — they are the paper's data.
# Only the heavy artifacts below are excluded (no trailing comments: git treats
# them as part of the pattern).
# datasets (src/data/ is source code and stays tracked)
/data/
# archived results from earlier protocol versions
/arxiv/
# cached real-image folders for FID (tens of thousands of PNGs)
/exps/fid/
# tuning state: binary and churning; logs/tune_*_winners.json is the result
optuna_db/
optuna_*.db
*.bin
*.zip

# model checkpoints
*.pt
*.pth

# editors
.vscode/
.idea/

# misc
.DS_Store
wandb/
CLAUDE.md

# logs/: keep the small result artifacts, drop the raw stdout
logs/*
!logs/tune_*_winners.json
!logs/flops.json
paper/
